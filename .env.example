# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings → API page. Leaving these unset keeps the app on the in-memory
# mock data layer — useful for local UI work with no backend at all.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put the service-role key or DB password here — those belong only in
# Supabase's Edge Function secrets (Settings → Edge Functions → Secrets),
# never in a file the browser loads.
